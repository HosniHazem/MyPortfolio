---
import { site, profile, links } from '../data/profile';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** Path for og:image; defaults to the site-wide card. */
  ogImage?: string;
  /** Extra JSON-LD to emit alongside the site-wide Person graph. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, ogImage = '/og/default.png', jsonLd, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/work/', label: 'Work' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/search/', label: 'Search' },
];

// Site-wide Person graph. Rendered on every page so any entry point describes who this is.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description: profile.summary,
  email: `mailto:${profile.email}`,
  url: site.url,
  address: { '@type': 'PostalAddress', addressLocality: 'Ariana', addressCountry: 'TN' },
  sameAs: links.filter((l) => l.href.startsWith('http')).map((l) => l.href),
  knowsLanguage: ['ar', 'fr', 'en'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111113" media="(prefers-color-scheme: dark)" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{profile.name}</a>
        <nav class="site-nav" aria-label="Primary">
          {nav.map((item) => {
            const itemPath = item.href.replace(/\/$/, '') || '/';
            return (
              <a href={item.href} aria-current={itemPath === path ? 'page' : undefined}>
                {item.label}
              </a>
            );
          })}
        </nav>
      </div>
    </header>

    <main id="main" class="wrap" data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <ul>
          {links.map((l) => (
            <li><a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>{l.label}</a></li>
          ))}
        </ul>
        <p>{profile.location} · Available in French, English and Arabic</p>
      </div>
    </footer>
  </body>
</html>
