---
import Base from '../../layouts/Base.astro';
import { profile } from '../../data/profile';
import { byYear } from '../../data/projects';
import { getRepoFacts } from '../../lib/github';

const title = `Projects — ${profile.name}`;
const description =
  'Personal projects: a multi-tenant clinic SaaS, a published analytics SDK, an AI résumé '
  + 'analyser, a Chrome Manifest V3 extension and a Kubernetes deployment pipeline.';

// Reconciled against the GitHub API at build time so these cannot silently go stale.
const facts = await getRepoFacts(byYear.map((p) => p.repo).filter(Boolean) as string[]);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Projects',
  hasPart: byYear.map((p) => ({
    '@type': 'SoftwareSourceCode',
    name: p.name,
    description: p.tagline,
    programmingLanguage: p.stack,
    ...(p.repo ? { codeRepository: p.repo } : {}),
  })),
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <p class="eyebrow">Personal work</p>
  <h1>Projects</h1>
  <p class="lede">{description}</p>

  <ul class="cards">
    {byYear.map((p) => {
      const f = p.repo ? facts[p.repo] : undefined;
      return (
        <li class="card">
          <p class="eyebrow">{p.year}{f?.language ? ` · ${f.language}` : ''}</p>
          <h3><a href={`/projects/${p.slug}/`}>{p.name}</a></h3>
          <p>{p.tagline}</p>
          <ul class="tags">{p.stack.slice(0, 4).map((s) => <li>{s}</li>)}</ul>
        </li>
      );
    })}
  </ul>
</Base>
