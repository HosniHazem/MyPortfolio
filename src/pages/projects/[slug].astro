---
import Base from '../../layouts/Base.astro';
import { profile } from '../../data/profile';
import { projects } from '../../data/projects';
import { getRepoFacts } from '../../lib/github';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const facts = project.repo ? (await getRepoFacts([project.repo]))[project.repo] : undefined;

const title = `${project.name} — ${profile.name}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: project.name,
  description: project.description,
  programmingLanguage: project.stack,
  author: { '@type': 'Person', name: profile.name },
  dateCreated: String(project.year),
  ...(project.repo ? { codeRepository: project.repo } : {}),
  ...(project.demo ? { url: project.demo } : {}),
};
---

<Base
  title={title}
  description={project.description}
  ogImage={`/og/${project.slug}.png`}
  jsonLd={jsonLd}
>
  <p class="eyebrow">{project.year} · Project</p>
  <h1>{project.name}</h1>
  <p class="lede">{project.tagline}</p>

  <p>{project.description}</p>

  {project.note && <p class="note">{project.note}</p>}

  <ul class="linkrow">
    {project.demo && <li><a href={project.demo} rel="noopener">Live demo →</a></li>}
    {project.repo && <li><a href={project.repo} rel="noopener">Source on GitHub →</a></li>}
    {project.npm && <li><a href={project.npm} rel="noopener">Package on npm →</a></li>}
  </ul>

  <h2>Stack</h2>
  <ul class="tags">{project.stack.map((s) => <li>{s}</li>)}</ul>

  {facts && (
    <>
      <h2>Repository</h2>
      <dl class="facts">
        {facts.language && <div><dt>Primary language</dt><dd>{facts.language}</dd></div>}
        <div><dt>Last updated</dt><dd>{facts.pushedAt}</dd></div>
        {facts.topics.length > 0 && (
          <div><dt>Topics</dt><dd>{facts.topics.join(', ')}</dd></div>
        )}
      </dl>
    </>
  )}

  <hr />
  <p><a href="/projects/">← All projects</a></p>
</Base>
